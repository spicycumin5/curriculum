# Supabase project → Settings → API (or "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # or the legacy anon key

# Optional: public URL used in confirmation emails (defaults to the request origin)
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Only for `npm run import` (CLI import of Claude-generated courses). NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
